exports[`renderers (snapshots) > agents: lean 1`] = `
{
  "AGENTS.md": "# acme

Monorepo for the Acme apps.

<!-- ai-rules:begin id=overview hash=d34b6583 -->
## Project overview
- pnpm monorepo with a NestJS API and a Flutter app.
<!-- ai-rules:end id=overview -->

<!-- ai-rules:begin id=commands hash=78ba6901 -->
## Commands
- Use \`pnpm\` for all package commands; never use npm or yarn.
- Test: \`pnpm test\`
<!-- ai-rules:end id=commands -->

<!-- ai-rules:begin id=code-style hash=60726b80 -->
## Code style
- Keep TypeScript \`strict\` mode on; do not use \`any\`.
<!-- ai-rules:end id=code-style -->

<!-- ai-rules:begin id=architecture hash=de884f19 -->
## Architecture
- Group features by domain folder. _(inferred)_
<!-- ai-rules:end id=architecture -->

<!-- ai-rules:begin id=security hash=464045ed -->
## Security
- Never commit \`.env\` files or secrets.
<!-- ai-rules:end id=security -->
",
  "apps/api/AGENTS.md": "# @acme/api

NestJS · TypeScript

<!-- ai-rules:begin id=commands hash=3f16382b -->
## Commands
- Test: \`pnpm --filter @acme/api test\`
<!-- ai-rules:end id=commands -->

<!-- ai-rules:begin id=architecture hash=0e5ea8d1 -->
## Architecture
- Organise code in NestJS modules under \`src/\`.
<!-- ai-rules:end id=architecture -->
",
  "apps/mobile/AGENTS.md": "# mobile

Flutter · Dart

<!-- ai-rules:begin id=architecture hash=c3e9fceb -->
## Architecture
- Use Riverpod providers for state.
<!-- ai-rules:end id=architecture -->

<!-- ai-rules:begin id=testing hash=34721729 -->
## Testing
- Put widget tests in \`test/\` next to the feature name.
<!-- ai-rules:end id=testing -->
",
}
`;

